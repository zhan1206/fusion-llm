  "use_cache": true,
  
  "block_size": 512,
  "latent_dim": 64,
  "window_size": 2048,
  
  "enable_thinking_dial": true,
  "num_thinking_depths": 4,
  
  "torch_dtype": "float16",
  "transformers_version": "4.36.0",
  
  "attn_implementation": "eager",
  
  "pad_token_id": 0,
  "bos_token_id": 1,
  "eos_token_id": 2
}
